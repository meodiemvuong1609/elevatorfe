# Sao chép thành .env trên server (Nuxt tự đọc file .env khi build/start).
# KHÔNG commit file .env thật lên git.

# URL công khai của site — dùng cho sitemap, robots, og:url.
# Production: https://hungphatelevator.com
# Subdomain staging: https://staging.hungphatelevator.com
SITE_URL=https://hungphatelevator.com

# Cho phép Google index hay không. Chỉ bật "true" ở production.
ALLOW_INDEXING=true

# Mapbox public token (pk.*) cho bản đồ ở footer / trang Liên hệ.
# Nên giới hạn URL được phép dùng token trong trang quản trị Mapbox.
ACCESS_TOKEN_MAP_BOX=

# Cổng / host cho `nuxt start` (mặc định 3000 / localhost)
PORT=3000
HOST=127.0.0.1
